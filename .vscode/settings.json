{
  // ======================================================================
  // VS Code Workspace Settings
  // ======================================================================
  // Purpose: Configure formatter, ESLint, and editor behavior for consistency
  // Docs: https://code.visualstudio.com/docs/getstarted/settings
  // ======================================================================

  // ---- Formatting & Saving ----
  // Use Prettier as the master formatter for this project
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // We disable `formatOnSave` because ESLint code actions handle formatting
  "editor.formatOnSave": false,

  "editor.codeActionsOnSave": {
    // Automatically fix lint errors and trigger Prettier on every save
    "source.fixAll.eslint": "explicit",
    // Automatically fix stylelint errors on save
    "source.fixAll.stylelint": "explicit"
  },

  // ---- Linter Integration ----
  // Allow ESLint to handle formatting (via Prettier plugin)
  "eslint.enable": true,
  "eslint.format.enable": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // ---- Stylelint Configuration ----
  // Enable stylelint for CSS/SCSS linting and auto-fixing
  "stylelint.enable": true,
  // File types that stylelint will validate
  "stylelint.validate": ["css", "scss"],

  // ---- PHP Configuration ----
  // Configure PHP file handling with PHPCS/PHPCBF via PHP_CodeSniffer integration
  "[php]": {
    // Run PHPCS/PHPCBF on save to fix style violations and organize imports
    "editor.codeActionsOnSave": { "source.fixAll": "explicit", "source.organizeImports": "explicit" },
    // Use PHP_CodeSniffer integration for PHP formatting
    "editor.defaultFormatter": "valeryanm.vscode-phpsab"
  },
  // Point to the WordPress coding standards configuration file (phpcs.xml)
  "phpsab.standard": "phpcs.xml"
}
