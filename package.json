{
  "name": "custom-plugin",
  "version": "1.0.0",
  "description": "Empower your WordPress plugin development with our starter pack, featuring Gulp pre-configured for effortlessly creating a custom WordPress Plugin Boilerplate in under a minute.",
  "scripts": {
    "dev": "gulp watch",
    "build": "gulp build",
    "format": "prettier --write --log-level error .",
    "format:check": "prettier --check .",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint \"**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "phplint": "composer lint",
    "phplint:fix": "composer lint:fix",
    "lint": "bun run eslint & bun run stylelint && bun run phplint",
    "lint:fix": "bun run eslint:fix & bun run stylelint:fix && bun run phplint:fix",
    "makepot": "bin/makepot.sh",
    "zip": "bin/build.sh",
    "build:zip": "bun run format && bun run lint && bun run makepot && bun run zip"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "license": "GPL-2.0-or-later",
  "author": {
    "name": "Vijay Hardaha",
    "url": "https://twitter.com/vijayhardaha"
  },
  "homepage": "https://github.com/vijayhardaha/wordpress-plugin-boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayhardaha/wordpress-plugin-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/vijayhardaha/wordpress-plugin-boilerplate/issues"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@eslint/compat": "^2.1.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@vijayhardaha/dev-config": "^2.1.0",
    "@wordpress/browserslist-config": "^6.48.0",
    "autoprefixer": "^10.5.0",
    "del": "^8.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "fancy-log": "^2.0.0",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-clone": "^2.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-flatten": "^0.4.0",
    "gulp-imagemin": "^9.2.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sass": "^6.0.1",
    "gulp-size": "^5.0.0",
    "gulp-terser": "^2.1.0",
    "husky": "^9.1.7",
    "merge-stream": "^2.0.0",
    "mkdirp": "^3.0.1",
    "postcss-discard-duplicates": "^8.0.0",
    "postcss-merge-rules": "^8.0.0",
    "prettier": "^3.8.4",
    "sass": "^1.100.0",
    "stylelint": "^17.13.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "core-js",
    "unrs-resolver"
  ]
}
