{
  "version": "1.0.0",
  "name": "viko/custom-plugin",
  "description": "This is a short description of your plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.3",
    "php-stubs/wordpress-stubs": "^6.9",
    "php-stubs/wordpress-globals": "^0.2.0",
    "php-stubs/woocommerce-stubs": "^10.6"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpcompatibility/phpcompatibility-wp": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "scripts": {
    "lint": "vendor/bin/phpcs -s -p",
    "lint:fix": "vendor/bin/phpcbf -p",
    "makepot": "bin/makepot.sh",
    "zip": "bin/build.sh"
  }
}
